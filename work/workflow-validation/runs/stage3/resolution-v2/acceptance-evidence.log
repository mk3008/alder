2026-09-10T09:40:07.5567947Z CREATE OR REPLACE FUNCTION s3_reject_schedule(a text,r text,s timestamptz) RETURNS void LANGUAGE plpgsql AS $$
2026-09-10T09:40:07.5568431Z BEGIN
2026-09-10T09:40:07.5568732Z   PERFORM schedule_maintenance(a,r,s); RAISE EXCEPTION 'unexpected schedule acceptance';
2026-09-10T09:40:07.5569193Z EXCEPTION WHEN OTHERS THEN IF SQLERRM='unexpected schedule acceptance' THEN RAISE; END IF;
2026-09-10T09:40:07.5569555Z END $$;
