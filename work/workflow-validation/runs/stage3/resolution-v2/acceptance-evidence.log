2026-09-10T09:40:07.5140573Z -- Stage 1 business operation. Validation uses PostgreSQL POSIX [[:space:]]
2026-09-10T09:40:07.5140973Z -- under the database collation/locale; it does not normalize stored text.
2026-09-10T09:40:07.5141340Z CREATE FUNCTION report_equipment_fault(
2026-09-10T09:40:07.5141601Z   p_request_id TEXT,
2026-09-10T09:40:07.5141866Z   p_equipment_id TEXT,
2026-09-10T09:40:07.5142100Z   p_reported_by TEXT,
2026-09-10T09:40:07.5142378Z   p_reported_at TIMESTAMPTZ,
2026-09-10T09:40:07.5142627Z   p_description TEXT
2026-09-10T09:40:07.5142846Z ) RETURNS TEXT
2026-09-10T09:40:07.5143056Z LANGUAGE plpgsql
2026-09-10T09:40:07.5143302Z AS $$
2026-09-10T09:40:07.5143501Z BEGIN
2026-09-10T09:40:07.5143806Z   IF p_description ~ '^[[:space:]]*$' THEN
2026-09-10T09:40:07.5144134Z     RAISE EXCEPTION 'description must be nonblank'
2026-09-10T09:40:07.5144467Z       USING ERRCODE = '22023';
2026-09-10T09:40:07.5144738Z   END IF;
2026-09-10T09:40:07.5144870Z 
2026-09-10T09:40:07.5145085Z   IF NOT EXISTS (SELECT 1 FROM equipment WHERE equipment_id = p_equipment_id) THEN
2026-09-10T09:40:07.5145439Z     RAISE EXCEPTION 'equipment does not exist'
2026-09-10T09:40:07.5145717Z       USING ERRCODE = '23503';
2026-09-10T09:40:07.5145941Z   END IF;
2026-09-10T09:40:07.5146064Z 
2026-09-10T09:40:07.5146194Z   INSERT INTO maintenance_request (
2026-09-10T09:40:07.5146539Z     request_id, equipment_id, reported_by, reported_at, description, status,
2026-09-10T09:40:07.5146870Z     scheduled_for, completed_at
2026-09-10T09:40:07.5147106Z   ) VALUES (
2026-09-10T09:40:07.5147397Z     p_request_id, p_equipment_id, p_reported_by, p_reported_at, p_description,
2026-09-10T09:40:07.5147759Z     'open', NULL, NULL
2026-09-10T09:40:07.5148108Z   );
2026-09-10T09:40:07.5148394Z 
2026-09-10T09:40:07.5148465Z   RETURN p_request_id;
2026-09-10T09:40:07.5148700Z END;
2026-09-10T09:40:07.5148892Z $$;
2026-09-10T09:40:07.5149126Z CREATE FUNCTION
2026-09-10T09:40:07.5149575Z -- Stage 2 business operations.  The authorization rows are an acceptance-only
2026-09-10T09:40:07.5150056Z -- fixture: they demonstrate the two explicitly authorized actors without
2026-09-10T09:40:07.5150498Z -- defining a broader identity or role-management policy.
2026-09-10T09:40:07.5150839Z CREATE TABLE stage2_authorization_fixture (
2026-09-10T09:40:07.5151121Z   actor_evidence TEXT PRIMARY KEY,
2026-09-10T09:40:07.5151605Z   role_name TEXT NOT NULL CHECK (role_name IN ('maintenance_coordinator', 'technician'))
2026-09-10T09:40:07.5151950Z );
2026-09-10T09:40:07.5152236Z CREATE TABLE
2026-09-10T09:40:07.5152529Z INSERT INTO stage2_authorization_fixture (actor_evidence, role_name) VALUES
2026-09-10T09:40:07.5152985Z   ('stage2-coordinator-fixture', 'maintenance_coordinator'),
2026-09-10T09:40:07.5153352Z   ('stage2-technician-fixture', 'technician');
2026-09-10T09:40:07.5153653Z INSERT 0 2
2026-09-10T09:40:07.5153908Z CREATE FUNCTION schedule_maintenance(
2026-09-10T09:40:07.5154165Z   p_actor_evidence TEXT,
2026-09-10T09:40:07.5154428Z   p_request_id TEXT,
2026-09-10T09:40:07.5154722Z   p_scheduled_for TIMESTAMPTZ
2026-09-10T09:40:07.5154957Z ) RETURNS TEXT
2026-09-10T09:40:07.5155267Z LANGUAGE plpgsql
2026-09-10T09:40:07.5155485Z AS $$
2026-09-10T09:40:07.5155661Z BEGIN
2026-09-10T09:40:07.5155895Z   IF NOT EXISTS (
2026-09-10T09:40:07.5156202Z     SELECT 1 FROM stage2_authorization_fixture
2026-09-10T09:40:07.5156483Z     WHERE actor_evidence = p_actor_evidence
2026-09-10T09:40:07.5156827Z       AND role_name = 'maintenance_coordinator'
2026-09-10T09:40:07.5157097Z   ) THEN
2026-09-10T09:40:07.5157398Z     RAISE EXCEPTION 'actor is not an authorized maintenance coordinator'
2026-09-10T09:40:07.5157808Z       USING ERRCODE = '42501';
2026-09-10T09:40:07.5158571Z   END IF;
2026-09-10T09:40:07.5158704Z 
2026-09-10T09:40:07.5158845Z   IF p_scheduled_for <= clock_timestamp() THEN
2026-09-10T09:40:07.5159229Z     RAISE EXCEPTION 'scheduled time must be future'
2026-09-10T09:40:07.5159534Z       USING ERRCODE = '22023';
2026-09-10T09:40:07.5159765Z   END IF;
2026-09-10T09:40:07.5159944Z 
2026-09-10T09:40:07.5160028Z   UPDATE maintenance_request
2026-09-10T09:40:07.5160338Z      SET status = 'scheduled', scheduled_for = p_scheduled_for
2026-09-10T09:40:07.5160708Z    WHERE request_id = p_request_id
2026-09-10T09:40:07.5161113Z      AND status = 'open'
2026-09-10T09:40:07.5161450Z      AND EXISTS (
2026-09-10T09:40:07.5161716Z        SELECT 1
2026-09-10T09:40:07.5161969Z        FROM equipment
2026-09-10T09:40:07.5162321Z        WHERE equipment.equipment_id = maintenance_request.equipment_id
2026-09-10T09:40:07.5162666Z          AND equipment.status <> 'safety_closed'
2026-09-10T09:40:07.5162967Z      );
2026-09-10T09:40:07.5163116Z 
2026-09-10T09:40:07.5163200Z   IF NOT FOUND THEN
2026-09-10T09:40:07.5163483Z     RAISE EXCEPTION 'request is not an open request'
2026-09-10T09:40:07.5163860Z       USING ERRCODE = '22023';
2026-09-10T09:40:07.5164244Z   END IF;
2026-09-10T09:40:07.5164348Z 
2026-09-10T09:40:07.5164463Z   RETURN p_request_id;
2026-09-10T09:40:07.5164738Z END;
2026-09-10T09:40:07.5164982Z $$;
2026-09-10T09:40:07.5165195Z CREATE FUNCTION
2026-09-10T09:40:07.5165471Z CREATE FUNCTION complete_maintenance(
2026-09-10T09:40:07.5165761Z   p_actor_evidence TEXT,
2026-09-10T09:40:07.5165987Z   p_request_id TEXT
2026-09-10T09:40:07.5166280Z ) RETURNS TEXT
2026-09-10T09:40:07.5166520Z LANGUAGE plpgsql
2026-09-10T09:40:07.5166730Z AS $$
2026-09-10T09:40:07.5167474Z DECLARE
2026-09-10T09:40:07.5167760Z   v_completed_at TIMESTAMPTZ;
2026-09-10T09:40:07.5168490Z BEGIN
2026-09-10T09:40:07.5168765Z   IF NOT EXISTS (
2026-09-10T09:40:07.5169105Z     SELECT 1 FROM stage2_authorization_fixture
2026-09-10T09:40:07.5169413Z     WHERE actor_evidence = p_actor_evidence
2026-09-10T09:40:07.5169719Z       AND role_name = 'technician'
2026-09-10T09:40:07.5170135Z   ) THEN
2026-09-10T09:40:07.5170511Z     RAISE EXCEPTION 'actor is not an authorized technician'
2026-09-10T09:40:07.5170938Z       USING ERRCODE = '42501';
2026-09-10T09:40:07.5171180Z   END IF;
2026-09-10T09:40:07.5171329Z 
2026-09-10T09:40:07.5171526Z   -- Capture once: this is both the chronology decision and the stored fact
2026-09-10T09:40:07.5171903Z   -- for this completion operation. A schedule is intentionally not a lower
2026-09-10T09:40:07.5172406Z   -- bound; only the decided report/completion chronology is enforced.
2026-09-10T09:40:07.5172736Z   v_completed_at := clock_timestamp();
2026-09-10T09:40:07.5172956Z 
2026-09-10T09:40:07.5173064Z   UPDATE maintenance_request
2026-09-10T09:40:07.5173349Z      SET status = 'completed', completed_at = v_completed_at
2026-09-10T09:40:07.5173732Z    WHERE request_id = p_request_id
2026-09-10T09:40:07.5174019Z      AND status = 'scheduled'
2026-09-10T09:40:07.5174269Z      AND reported_at <= v_completed_at;
2026-09-10T09:40:07.5174471Z 
2026-09-10T09:40:07.5174618Z   IF NOT FOUND THEN
2026-09-10T09:40:07.5174917Z     RAISE EXCEPTION 'request is not a completable scheduled request'
2026-09-10T09:40:07.5175306Z       USING ERRCODE = '22023';
2026-09-10T09:40:07.5175584Z   END IF;
2026-09-10T09:40:07.5175717Z 
2026-09-10T09:40:07.5175804Z   RETURN p_request_id;
2026-09-10T09:40:07.5176160Z END;
2026-09-10T09:40:07.5176370Z $$;
2026-09-10T09:40:07.5176604Z CREATE FUNCTION
2026-09-10T09:40:07.5177001Z -- Stage 3 business operation. This acceptance-only fixture demonstrates the
2026-09-10T09:40:07.5177440Z -- explicitly required safety-inspector authority; it is not an identity model.
2026-09-10T09:40:07.5177873Z CREATE TABLE stage3_authorization_fixture (
2026-09-10T09:40:07.5178403Z   actor_evidence TEXT PRIMARY KEY,
2026-09-10T09:40:07.5178743Z   role_name TEXT NOT NULL CHECK (role_name = 'safety_inspector')
2026-09-10T09:40:07.5179118Z );
2026-09-10T09:40:07.5179331Z CREATE TABLE
2026-09-10T09:40:07.5179634Z INSERT INTO stage3_authorization_fixture (actor_evidence, role_name) VALUES
2026-09-10T09:40:07.5180152Z   ('stage3-safety-inspector-fixture', 'safety_inspector');
2026-09-10T09:40:07.5180492Z INSERT 0 1
2026-09-10T09:40:07.5180779Z CREATE FUNCTION record_safety_closure(
2026-09-10T09:40:07.5181052Z   p_actor_evidence TEXT,
2026-09-10T09:40:07.5181278Z   p_equipment_id TEXT
2026-09-10T09:40:07.5181584Z ) RETURNS TEXT
2026-09-10T09:40:07.5181822Z LANGUAGE plpgsql
2026-09-10T09:40:07.5182025Z AS $$
2026-09-10T09:40:07.5182344Z BEGIN
2026-09-10T09:40:07.5182625Z   IF NOT EXISTS (
2026-09-10T09:40:07.5182872Z     SELECT 1 FROM stage3_authorization_fixture
2026-09-10T09:40:07.5183207Z     WHERE actor_evidence = p_actor_evidence
2026-09-10T09:40:07.5183499Z       AND role_name = 'safety_inspector'
2026-09-10T09:40:07.5183767Z   ) THEN
2026-09-10T09:40:07.5184113Z     RAISE EXCEPTION 'actor is not an authorized safety inspector'
2026-09-10T09:40:07.5184419Z       USING ERRCODE = '42501';
2026-09-10T09:40:07.5184754Z   END IF;
2026-09-10T09:40:07.5184916Z 
2026-09-10T09:40:07.5185004Z   UPDATE equipment
2026-09-10T09:40:07.5185308Z      SET status = 'safety_closed'
2026-09-10T09:40:07.5185692Z    WHERE equipment_id = p_equipment_id;
2026-09-10T09:40:07.5185858Z 
2026-09-10T09:40:07.5185965Z   RETURN p_equipment_id;
2026-09-10T09:40:07.5186213Z END;
2026-09-10T09:40:07.5186491Z $$;
2026-09-10T09:40:07.5186749Z CREATE FUNCTION
2026-09-10T09:40:07.5187078Z -- Executable observations and gates for frozen Stage 1 acceptance v3.
2026-09-10T09:40:07.5187452Z \set ON_ERROR_STOP on
2026-09-10T09:40:07.5187705Z SET TIME ZONE 'UTC';
2026-09-10T09:40:07.5187982Z SET
2026-09-10T09:40:07.5188326Z \pset format unaligned
2026-09-10T09:40:07.5188553Z Output format is unaligned.
2026-09-10T09:40:07.5188832Z \pset null 'NULL'
2026-09-10T09:40:07.5189097Z Null display is "NULL".
2026-09-10T09:40:07.5190370Z CREATE OR REPLACE FUNCTION stage1_input(c text,rid text,eid text,reporter text,at_time timestamptz,d text) RETURNS TABLE(case_id text,actor_evidence text,request_id text,equipment_id text,reported_by text,reported_at text,description_utf8_hex text) LANGUAGE sql AS $$ SELECT c,'reporter',rid,eid,reporter,to_char(at_time AT TIME ZONE 'UTC','YYYY-MM-DD"T"HH24:MI:SS"Z"'),encode(convert_to(d,'UTF8'),'hex') $$;
2026-09-10T09:40:07.5191532Z CREATE FUNCTION
2026-09-10T09:40:07.5191928Z -- Rejection encoding is intentionally not asserted; the post-call count gates prove no write.
2026-09-10T09:40:07.5192962Z CREATE OR REPLACE FUNCTION stage1_rejected(c text,rid text,eid text,reporter text,at_time timestamptz,d text) RETURNS void LANGUAGE plpgsql AS $$ BEGIN PERFORM report_equipment_fault(rid,eid,reporter,at_time,d); RAISE EXCEPTION '% unexpectedly accepted',c; EXCEPTION WHEN OTHERS THEN IF SQLERRM LIKE '%'||c||' unexpectedly accepted' THEN RAISE; END IF; END $$;
2026-09-10T09:40:07.5194000Z CREATE FUNCTION
2026-09-10T09:40:07.5195009Z CREATE OR REPLACE FUNCTION stage1_setup(c text) RETURNS void LANGUAGE plpgsql AS $$ BEGIN TRUNCATE maintenance_request; INSERT INTO equipment(equipment_id,status) VALUES ('eq-stage1-known','available'),('eq-stage1-other','available') ON CONFLICT(equipment_id) DO UPDATE SET status=EXCLUDED.status; IF (SELECT count(*) FROM maintenance_request)<>0 THEN RAISE EXCEPTION '% setup failed',c; END IF; END $$;
2026-09-10T09:40:07.5195998Z CREATE FUNCTION
2026-09-10T09:40:07.5196274Z -- Accepted-row observation and exact all-field/count assertion.
2026-09-10T09:40:07.5197594Z CREATE OR REPLACE FUNCTION stage1_accepted(c text,rid text,at_time timestamptz,d text,expected_total bigint) RETURNS void LANGUAGE plpgsql AS $$ BEGIN IF (SELECT count(*) FROM maintenance_request WHERE request_id=rid AND equipment_id='eq-stage1-known' AND reported_by='reporter-stage1' AND reported_at=at_time AND description=d AND status='open' AND scheduled_for IS NULL AND completed_at IS NULL)<>1 OR (SELECT count(*) FROM maintenance_request)<>expected_total THEN RAISE EXCEPTION '% failed',c; END IF; END $$;
