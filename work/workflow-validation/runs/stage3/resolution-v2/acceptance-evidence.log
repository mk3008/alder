2026-09-10T09:40:07.5564258Z CREATE OR REPLACE FUNCTION s3_setup(c text) RETURNS void LANGUAGE plpgsql AS $$
2026-09-10T09:40:07.5564592Z BEGIN
2026-09-10T09:40:07.5564809Z   TRUNCATE maintenance_request;
2026-09-10T09:40:07.5565231Z   INSERT INTO equipment(equipment_id,status) VALUES ('eq-stage3-known','available')
2026-09-10T09:40:07.5565701Z     ON CONFLICT(equipment_id) DO UPDATE SET status=EXCLUDED.status;
2026-09-10T09:40:07.5566062Z   IF (SELECT count(*) FROM maintenance_request) <> 0
2026-09-10T09:40:07.5566482Z      OR (SELECT count(*) FROM equipment WHERE equipment_id='eq-stage3-known' AND status='available') <> 1 THEN
2026-09-10T09:40:07.5566884Z     RAISE EXCEPTION '% setup failed', c;
2026-09-10T09:40:07.5567131Z   END IF;
2026-09-10T09:40:07.5567375Z END $$;
