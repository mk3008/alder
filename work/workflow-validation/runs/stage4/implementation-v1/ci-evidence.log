2026-09-10T09:49:52.8743524Z CREATE OR REPLACE FUNCTION s3_setup(c text) RETURNS void LANGUAGE plpgsql AS $$
2026-09-10T09:49:52.8743601Z BEGIN
2026-09-10T09:49:52.8743698Z   TRUNCATE maintenance_request;
2026-09-10T09:49:52.8743928Z   INSERT INTO equipment(equipment_id,status) VALUES ('eq-stage3-known','available')
2026-09-10T09:49:52.8744101Z     ON CONFLICT(equipment_id) DO UPDATE SET status=EXCLUDED.status;
2026-09-10T09:49:52.8744234Z   IF (SELECT count(*) FROM maintenance_request) <> 0
2026-09-10T09:49:52.8744538Z      OR (SELECT count(*) FROM equipment WHERE equipment_id='eq-stage3-known' AND status='available') <> 1 THEN
2026-09-10T09:49:52.8744645Z     RAISE EXCEPTION '% setup failed', c;
2026-09-10T09:49:52.8744718Z   END IF;
2026-09-10T09:49:52.8744793Z END $$;
2026-09-10T09:49:52.8744870Z CREATE FUNCTION
2026-09-10T09:49:52.8745185Z CREATE OR REPLACE FUNCTION s3_reject_schedule(a text,r text,s timestamptz) RETURNS void LANGUAGE plpgsql AS $$
2026-09-10T09:49:52.8745255Z BEGIN
2026-09-10T09:49:52.8745497Z   PERFORM schedule_maintenance(a,r,s); RAISE EXCEPTION 'unexpected schedule acceptance';
2026-09-10T09:49:52.8745741Z EXCEPTION WHEN OTHERS THEN IF SQLERRM='unexpected schedule acceptance' THEN RAISE; END IF;
2026-09-10T09:49:52.8745821Z END $$;
2026-09-10T09:49:52.8745901Z CREATE FUNCTION
2026-09-10T09:49:52.8746167Z CREATE OR REPLACE FUNCTION s3_reject_closure(a text,e text) RETURNS void LANGUAGE plpgsql AS $$
2026-09-10T09:49:52.8746239Z BEGIN
