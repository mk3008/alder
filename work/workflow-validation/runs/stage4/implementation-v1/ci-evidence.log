2026-09-10T09:49:52.8087941Z -- Stage 1 business operation. Validation uses PostgreSQL POSIX [[:space:]]
2026-09-10T09:49:52.8088437Z -- under the database collation/locale; it does not normalize stored text.
2026-09-10T09:49:52.8088841Z CREATE FUNCTION report_equipment_fault(
2026-09-10T09:49:52.8089117Z   p_request_id TEXT,
2026-09-10T09:49:52.8089330Z   p_equipment_id TEXT,
2026-09-10T09:49:52.8089544Z   p_reported_by TEXT,
2026-09-10T09:49:52.8089759Z   p_reported_at TIMESTAMPTZ,
2026-09-10T09:49:52.8089996Z   p_description TEXT
2026-09-10T09:49:52.8090193Z ) RETURNS TEXT
2026-09-10T09:49:52.8090394Z LANGUAGE plpgsql
2026-09-10T09:49:52.8090594Z AS $$
2026-09-10T09:49:52.8090763Z BEGIN
2026-09-10T09:49:52.8090970Z   IF p_description ~ '^[[:space:]]*$' THEN
2026-09-10T09:49:52.8091284Z     RAISE EXCEPTION 'description must be nonblank'
2026-09-10T09:49:52.8091584Z       USING ERRCODE = '22023';
2026-09-10T09:49:52.8091803Z   END IF;
2026-09-10T09:49:52.8091898Z 
2026-09-10T09:49:52.8092112Z   IF NOT EXISTS (SELECT 1 FROM equipment WHERE equipment_id = p_equipment_id) THEN
2026-09-10T09:49:52.8092712Z     RAISE EXCEPTION 'equipment does not exist'
2026-09-10T09:49:52.8092987Z       USING ERRCODE = '23503';
2026-09-10T09:49:52.8093203Z   END IF;
2026-09-10T09:49:52.8093464Z 
2026-09-10T09:49:52.8093562Z   INSERT INTO maintenance_request (
2026-09-10T09:49:52.8093937Z     request_id, equipment_id, reported_by, reported_at, description, status,
2026-09-10T09:49:52.8094324Z     scheduled_for, completed_at
2026-09-10T09:49:52.8094550Z   ) VALUES (
2026-09-10T09:49:52.8094847Z     p_request_id, p_equipment_id, p_reported_by, p_reported_at, p_description,
2026-09-10T09:49:52.8095224Z     'open', NULL, NULL
2026-09-10T09:49:52.8095419Z   );
2026-09-10T09:49:52.8095519Z 
2026-09-10T09:49:52.8095600Z   RETURN p_request_id;
2026-09-10T09:49:52.8095797Z END;
2026-09-10T09:49:52.8095957Z $$;
2026-09-10T09:49:52.8096127Z CREATE FUNCTION
2026-09-10T09:49:52.8096453Z -- Stage 2 business operations.  The authorization rows are an acceptance-only
2026-09-10T09:49:52.8097206Z -- fixture: they demonstrate the two explicitly authorized actors without
2026-09-10T09:49:52.8097650Z -- defining a broader identity or role-management policy.
2026-09-10T09:49:52.8097996Z CREATE TABLE stage2_authorization_fixture (
2026-09-10T09:49:52.8098287Z   actor_evidence TEXT PRIMARY KEY,
2026-09-10T09:49:52.8098680Z   role_name TEXT NOT NULL CHECK (role_name IN ('maintenance_coordinator', 'technician'))
2026-09-10T09:49:52.8099072Z );
2026-09-10T09:49:52.8099239Z CREATE TABLE
2026-09-10T09:49:52.8099542Z INSERT INTO stage2_authorization_fixture (actor_evidence, role_name) VALUES
2026-09-10T09:49:52.8099996Z   ('stage2-coordinator-fixture', 'maintenance_coordinator'),
2026-09-10T09:49:52.8100503Z   ('stage2-technician-fixture', 'technician');
2026-09-10T09:49:52.8100932Z INSERT 0 2
2026-09-10T09:49:52.8101272Z CREATE FUNCTION schedule_maintenance(
2026-09-10T09:49:52.8101722Z   p_actor_evidence TEXT,
2026-09-10T09:49:52.8102092Z   p_request_id TEXT,
2026-09-10T09:49:52.8102469Z   p_scheduled_for TIMESTAMPTZ
2026-09-10T09:49:52.8102817Z ) RETURNS TEXT
2026-09-10T09:49:52.8103008Z LANGUAGE plpgsql
2026-09-10T09:49:52.8103192Z AS $$
2026-09-10T09:49:52.8103355Z BEGIN
2026-09-10T09:49:52.8103522Z   IF NOT EXISTS (
2026-09-10T09:49:52.8103748Z     SELECT 1 FROM stage2_authorization_fixture
2026-09-10T09:49:52.8104038Z     WHERE actor_evidence = p_actor_evidence
2026-09-10T09:49:52.8104331Z       AND role_name = 'maintenance_coordinator'
2026-09-10T09:49:52.8104594Z   ) THEN
2026-09-10T09:49:52.8104870Z     RAISE EXCEPTION 'actor is not an authorized maintenance coordinator'
2026-09-10T09:49:52.8105234Z       USING ERRCODE = '42501';
2026-09-10T09:49:52.8105448Z   END IF;
2026-09-10T09:49:52.8105548Z 
2026-09-10T09:49:52.8105656Z   IF p_scheduled_for <= clock_timestamp() THEN
2026-09-10T09:49:52.8105965Z     RAISE EXCEPTION 'scheduled time must be future'
2026-09-10T09:49:52.8106252Z       USING ERRCODE = '22023';
2026-09-10T09:49:52.8106467Z   END IF;
2026-09-10T09:49:52.8106570Z 
2026-09-10T09:49:52.8106663Z   UPDATE maintenance_request
2026-09-10T09:49:52.8107168Z      SET status = 'scheduled', scheduled_for = p_scheduled_for
2026-09-10T09:49:52.8107496Z    WHERE request_id = p_request_id
2026-09-10T09:49:52.8107742Z      AND status = 'open'
2026-09-10T09:49:52.8107949Z      AND EXISTS (
2026-09-10T09:49:52.8108217Z        SELECT 1
2026-09-10T09:49:52.8108549Z        FROM equipment
2026-09-10T09:49:52.8109068Z        WHERE equipment.equipment_id = maintenance_request.equipment_id
2026-09-10T09:49:52.8109738Z          AND equipment.status <> 'safety_closed'
2026-09-10T09:49:52.8110232Z      );
2026-09-10T09:49:52.8110418Z 
2026-09-10T09:49:52.8110574Z   IF NOT FOUND THEN
2026-09-10T09:49:52.8110883Z     RAISE EXCEPTION 'request is not an open request'
2026-09-10T09:49:52.8111340Z       USING ERRCODE = '22023';
2026-09-10T09:49:52.8111567Z   END IF;
2026-09-10T09:49:52.8111667Z 
2026-09-10T09:49:52.8111755Z   RETURN p_request_id;
2026-09-10T09:49:52.8111954Z END;
2026-09-10T09:49:52.8112428Z $$;
2026-09-10T09:49:52.8112633Z CREATE FUNCTION
2026-09-10T09:49:52.8112853Z CREATE FUNCTION complete_maintenance(
2026-09-10T09:49:52.8113213Z   p_actor_evidence TEXT,
2026-09-10T09:49:52.8113493Z   p_request_id TEXT
2026-09-10T09:49:52.8114023Z ) RETURNS TEXT
2026-09-10T09:49:52.8114238Z LANGUAGE plpgsql
2026-09-10T09:49:52.8114429Z AS $$
2026-09-10T09:49:52.8114602Z DECLARE
2026-09-10T09:49:52.8114943Z   v_completed_at TIMESTAMPTZ;
2026-09-10T09:49:52.8115181Z BEGIN
2026-09-10T09:49:52.8115354Z   IF NOT EXISTS (
2026-09-10T09:49:52.8115580Z     SELECT 1 FROM stage2_authorization_fixture
2026-09-10T09:49:52.8115929Z     WHERE actor_evidence = p_actor_evidence
2026-09-10T09:49:52.8116299Z       AND role_name = 'technician'
2026-09-10T09:49:52.8116536Z   ) THEN
2026-09-10T09:49:52.8116778Z     RAISE EXCEPTION 'actor is not an authorized technician'
2026-09-10T09:49:52.8117413Z       USING ERRCODE = '42501';
2026-09-10T09:49:52.8117647Z   END IF;
2026-09-10T09:49:52.8117749Z 
2026-09-10T09:49:52.8117962Z   -- Capture once: this is both the chronology decision and the stored fact
2026-09-10T09:49:52.8118583Z   -- for this completion operation. A schedule is intentionally not a lower
2026-09-10T09:49:52.8119065Z   -- bound; only the decided report/completion chronology is enforced.
2026-09-10T09:49:52.8119440Z   v_completed_at := clock_timestamp();
2026-09-10T09:49:52.8119748Z 
2026-09-10T09:49:52.8119846Z   UPDATE maintenance_request
2026-09-10T09:49:52.8120135Z      SET status = 'completed', completed_at = v_completed_at
2026-09-10T09:49:52.8120463Z    WHERE request_id = p_request_id
2026-09-10T09:49:52.8120797Z      AND status = 'scheduled'
2026-09-10T09:49:52.8121116Z      AND reported_at <= v_completed_at;
2026-09-10T09:49:52.8121294Z 
2026-09-10T09:49:52.8121377Z   IF NOT FOUND THEN
2026-09-10T09:49:52.8121669Z     RAISE EXCEPTION 'request is not a completable scheduled request'
2026-09-10T09:49:52.8122143Z       USING ERRCODE = '22023';
2026-09-10T09:49:52.8122366Z   END IF;
2026-09-10T09:49:52.8122477Z 
2026-09-10T09:49:52.8122556Z   RETURN p_request_id;
2026-09-10T09:49:52.8122752Z END;
2026-09-10T09:49:52.8122914Z $$;
2026-09-10T09:49:52.8123166Z CREATE FUNCTION
2026-09-10T09:49:52.8123551Z -- Stage 3 business operation. This acceptance-only fixture demonstrates the
2026-09-10T09:49:52.8124078Z -- explicitly required safety-inspector authority; it is not an identity model.
2026-09-10T09:49:52.8124636Z CREATE TABLE stage3_authorization_fixture (
2026-09-10T09:49:52.8124924Z   actor_evidence TEXT PRIMARY KEY,
2026-09-10T09:49:52.8125249Z   role_name TEXT NOT NULL CHECK (role_name = 'safety_inspector')
2026-09-10T09:49:52.8125698Z );
2026-09-10T09:49:52.8125866Z CREATE TABLE
2026-09-10T09:49:52.8126172Z INSERT INTO stage3_authorization_fixture (actor_evidence, role_name) VALUES
2026-09-10T09:49:52.8126710Z   ('stage3-safety-inspector-fixture', 'safety_inspector');
2026-09-10T09:49:52.8127238Z INSERT 0 1
2026-09-10T09:49:52.8127447Z CREATE FUNCTION record_safety_closure(
2026-09-10T09:49:52.8127803Z   p_actor_evidence TEXT,
2026-09-10T09:49:52.8128119Z   p_equipment_id TEXT
2026-09-10T09:49:52.8128323Z ) RETURNS TEXT
2026-09-10T09:49:52.8128511Z LANGUAGE plpgsql
2026-09-10T09:49:52.8128695Z AS $$
2026-09-10T09:49:52.8128861Z BEGIN
2026-09-10T09:49:52.8129169Z   IF NOT EXISTS (
2026-09-10T09:49:52.8129408Z     SELECT 1 FROM stage3_authorization_fixture
2026-09-10T09:49:52.8129701Z     WHERE actor_evidence = p_actor_evidence
2026-09-10T09:49:52.8129975Z       AND role_name = 'safety_inspector'
2026-09-10T09:49:52.8130357Z   ) THEN
2026-09-10T09:49:52.8130627Z     RAISE EXCEPTION 'actor is not an authorized safety inspector'
2026-09-10T09:49:52.8130979Z       USING ERRCODE = '42501';
2026-09-10T09:49:52.8131200Z   END IF;
2026-09-10T09:49:52.8131366Z 
2026-09-10T09:49:52.8131517Z   UPDATE equipment
2026-09-10T09:49:52.8131742Z      SET status = 'safety_closed'
2026-09-10T09:49:52.8131997Z    WHERE equipment_id = p_equipment_id;
2026-09-10T09:49:52.8132174Z 
2026-09-10T09:49:52.8132264Z   RETURN p_equipment_id;
2026-09-10T09:49:52.8132778Z END;
2026-09-10T09:49:52.8132944Z $$;
2026-09-10T09:49:52.8133109Z CREATE FUNCTION
2026-09-10T09:49:52.8133425Z -- Stage 4: the same equipment-safety owner and existing inspector authority.
2026-09-10T09:49:52.8134201Z CREATE FUNCTION clear_safety_closure(p_actor_evidence TEXT, p_equipment_id TEXT)
2026-09-10T09:49:52.8134617Z RETURNS TEXT LANGUAGE plpgsql AS $$
2026-09-10T09:49:52.8134923Z BEGIN
2026-09-10T09:49:52.8135173Z   IF NOT EXISTS (
2026-09-10T09:49:52.8135459Z     SELECT 1 FROM stage3_authorization_fixture
2026-09-10T09:49:52.8135889Z     WHERE actor_evidence=p_actor_evidence AND role_name='safety_inspector'
2026-09-10T09:49:52.8136480Z   ) THEN
2026-09-10T09:49:52.8136937Z     RAISE EXCEPTION 'actor is not an authorized safety inspector' USING ERRCODE='42501';
2026-09-10T09:49:52.8137534Z   END IF;
2026-09-10T09:49:52.8137739Z   UPDATE equipment SET status='available'
2026-09-10T09:49:52.8138086Z   WHERE equipment_id=p_equipment_id AND status='safety_closed';
2026-09-10T09:49:52.8138495Z   RETURN p_equipment_id;
2026-09-10T09:49:52.8138780Z END;
2026-09-10T09:49:52.8138946Z $$;
2026-09-10T09:49:52.8139120Z CREATE FUNCTION
2026-09-10T09:49:52.8139424Z -- Executable observations and gates for frozen Stage 1 acceptance v3.
