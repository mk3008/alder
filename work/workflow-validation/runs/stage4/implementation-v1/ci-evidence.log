2026-09-10T09:49:52.8143289Z CREATE OR REPLACE FUNCTION stage1_input(c text,rid text,eid text,reporter text,at_time timestamptz,d text) RETURNS TABLE(case_id text,actor_evidence text,request_id text,equipment_id text,reported_by text,reported_at text,description_utf8_hex text) LANGUAGE sql AS $$ SELECT c,'reporter',rid,eid,reporter,to_char(at_time AT TIME ZONE 'UTC','YYYY-MM-DD"T"HH24:MI:SS"Z"'),encode(convert_to(d,'UTF8'),'hex') $$;
2026-09-10T09:49:52.8144955Z CREATE FUNCTION
2026-09-10T09:49:52.8145344Z -- Rejection encoding is intentionally not asserted; the post-call count gates prove no write.
2026-09-10T09:49:52.8147318Z CREATE OR REPLACE FUNCTION stage1_rejected(c text,rid text,eid text,reporter text,at_time timestamptz,d text) RETURNS void LANGUAGE plpgsql AS $$ BEGIN PERFORM report_equipment_fault(rid,eid,reporter,at_time,d); RAISE EXCEPTION '% unexpectedly accepted',c; EXCEPTION WHEN OTHERS THEN IF SQLERRM LIKE '%'||c||' unexpectedly accepted' THEN RAISE; END IF; END $$;
2026-09-10T09:49:52.8148808Z CREATE FUNCTION
2026-09-10T09:49:52.8150472Z CREATE OR REPLACE FUNCTION stage1_setup(c text) RETURNS void LANGUAGE plpgsql AS $$ BEGIN TRUNCATE maintenance_request; INSERT INTO equipment(equipment_id,status) VALUES ('eq-stage1-known','available'),('eq-stage1-other','available') ON CONFLICT(equipment_id) DO UPDATE SET status=EXCLUDED.status; IF (SELECT count(*) FROM maintenance_request)<>0 THEN RAISE EXCEPTION '% setup failed',c; END IF; END $$;
2026-09-10T09:49:52.8152167Z CREATE FUNCTION
2026-09-10T09:49:52.8152595Z -- Accepted-row observation and exact all-field/count assertion.
2026-09-10T09:49:52.8155020Z CREATE OR REPLACE FUNCTION stage1_accepted(c text,rid text,at_time timestamptz,d text,expected_total bigint) RETURNS void LANGUAGE plpgsql AS $$ BEGIN IF (SELECT count(*) FROM maintenance_request WHERE request_id=rid AND equipment_id='eq-stage1-known' AND reported_by='reporter-stage1' AND reported_at=at_time AND description=d AND status='open' AND scheduled_for IS NULL AND completed_at IS NULL)<>1 OR (SELECT count(*) FROM maintenance_request)<>expected_total THEN RAISE EXCEPTION '% failed',c; END IF; END $$;
2026-09-10T09:49:52.8157399Z CREATE FUNCTION
2026-09-10T09:49:52.8157663Z -- S1-01
2026-09-10T09:49:52.8161587Z SELECT stage1_setup('S1-01'); SELECT * FROM stage1_input('S1-01','req-stage1-01','eq-stage1-known','reporter-stage1','2030-01-15T10:30:00Z','Hydraulic pressure warning observed'); SELECT 'S1-01 setup' observation,count(*) request_count FROM maintenance_request; SELECT report_equipment_fault('req-stage1-01','eq-stage1-known','reporter-stage1','2030-01-15T10:30:00Z','Hydraulic pressure warning observed') accepted_request_id; SELECT 'S1-01 accepted' call_outcome; SELECT 'S1-01 row' observation,request_id,equipment_id,reported_by,to_char(reported_at AT TIME ZONE 'UTC','YYYY-MM-DD"T"HH24:MI:SS"Z"') reported_at,description,status,scheduled_for,completed_at FROM maintenance_request WHERE request_id='req-stage1-01'; SELECT 'S1-01 total' observation,count(*) request_count FROM maintenance_request; SELECT stage1_accepted('S1-01','req-stage1-01','2030-01-15T10:30:00Z','Hydraulic pressure warning observed',1);
