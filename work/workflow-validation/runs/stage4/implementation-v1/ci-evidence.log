2026-09-10T09:49:52.8824467Z CREATE FUNCTION s4_setup(c text) RETURNS void LANGUAGE plpgsql AS $$
2026-09-10T09:49:52.8824539Z BEGIN
2026-09-10T09:49:52.8824637Z   TRUNCATE maintenance_request;
2026-09-10T09:49:52.8824803Z   INSERT INTO equipment VALUES ('eq-stage4-known','available')
2026-09-10T09:49:52.8824963Z   ON CONFLICT(equipment_id) DO UPDATE SET status='available';
2026-09-10T09:49:52.8825063Z   RAISE NOTICE 'case %',c;
2026-09-10T09:49:52.8825136Z END $$;
2026-09-10T09:49:52.8825220Z CREATE FUNCTION
2026-09-10T09:49:52.8825477Z CREATE FUNCTION s4_equipment(expected text,n integer) RETURNS void LANGUAGE plpgsql AS $$
2026-09-10T09:49:52.8825555Z BEGIN
2026-09-10T09:49:52.8825823Z   IF (SELECT count(*) FROM equipment WHERE equipment_id='eq-stage4-known' AND status=expected)<>1
2026-09-10T09:49:52.8825952Z      OR (SELECT count(*) FROM maintenance_request)<>n
2026-09-10T09:49:52.8826118Z   THEN RAISE EXCEPTION 'S4 equipment/count gate failed'; END IF;
2026-09-10T09:49:52.8826191Z END $$;
2026-09-10T09:49:52.8826275Z CREATE FUNCTION
2026-09-10T09:49:52.8826507Z CREATE FUNCTION s4_state(expected text,reported timestamptz,scheduled timestamptz)
2026-09-10T09:49:52.8826615Z RETURNS void LANGUAGE plpgsql AS $$
2026-09-10T09:49:52.8826686Z BEGIN
2026-09-10T09:49:52.8827136Z   IF (SELECT count(*) FROM maintenance_request WHERE request_id='req-stage4-open'
2026-09-10T09:49:52.8827361Z       AND equipment_id='eq-stage4-known' AND reported_by='reporter-stage4'
2026-09-10T09:49:52.8827544Z       AND reported_at=reported AND description='Stage 4 reported fault'
2026-09-10T09:49:52.8827738Z       AND status=expected AND scheduled_for IS NOT DISTINCT FROM scheduled
2026-09-10T09:49:52.8827940Z       AND completed_at IS NULL)<>1 OR (SELECT count(*) FROM maintenance_request)<>1
2026-09-10T09:49:52.8828098Z   THEN RAISE EXCEPTION 'S4 complete row gate failed'; END IF;
2026-09-10T09:49:52.8828177Z END $$;
2026-09-10T09:49:52.8828256Z CREATE FUNCTION
2026-09-10T09:49:52.8828414Z CREATE FUNCTION s4_same() RETURNS void LANGUAGE plpgsql AS $$
2026-09-10T09:49:52.8828485Z BEGIN
2026-09-10T09:49:52.8828718Z   IF (SELECT count(*) FROM s4_pre_call)<>1 OR (SELECT count(*) FROM maintenance_request)<>1
2026-09-10T09:49:52.8828955Z      OR EXISTS (SELECT * FROM s4_pre_call EXCEPT SELECT * FROM maintenance_request)
2026-09-10T09:49:52.8829166Z      OR EXISTS (SELECT * FROM maintenance_request EXCEPT SELECT * FROM s4_pre_call)
2026-09-10T09:49:52.8829343Z   THEN RAISE EXCEPTION 'S4 request changed unexpectedly'; END IF;
2026-09-10T09:49:52.8829416Z END $$;
2026-09-10T09:49:52.8829498Z CREATE FUNCTION
2026-09-10T09:49:52.8829718Z CREATE FUNCTION s4_reject_clear(actor text) RETURNS void LANGUAGE plpgsql AS $$
2026-09-10T09:49:52.8829796Z BEGIN
2026-09-10T09:49:52.8829940Z   PERFORM clear_safety_closure(actor,'eq-stage4-known');
2026-09-10T09:49:52.8830070Z   RAISE EXCEPTION 'unexpected clear acceptance';
2026-09-10T09:49:52.8830305Z EXCEPTION WHEN OTHERS THEN IF SQLERRM='unexpected clear acceptance' THEN RAISE; END IF;
2026-09-10T09:49:52.8830383Z END $$;
