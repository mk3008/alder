              {
                "id": "0b08d343-bb58-4c3c-986c-6f818de43f18",
                "text": "受付スタッフが利用者から受け取った希望日と連絡先を案内台帳に登録する。",
                "obligation": "required",
                "appliesWhen": null,
                "performerObjectIds": [
                  "8a8a553f-0021-4741-a529-8568bfc1eb83"
                ]
              },
              {
                "id": "2a4d6355-2b58-40d6-a6e4-4dea5122da90",
                "text": "受付スタッフが利用者から届いている希望詳細も案内台帳に記録する。",
                "obligation": "required",
                "appliesWhen": "希望詳細が届いている場合",
                "performerObjectIds": [
                  "8a8a553f-0021-4741-a529-8568bfc1eb83"
                ]
              },
              {
                "id": "e091d686-2744-40f6-9dad-1d68160404a2",
                "text": "案内システムが案内台帳から来訪日と連絡先を読み戻し、利用者へ通知する。",
                "obligation": "required",
                "appliesWhen": null,
                "performerObjectIds": [
                  "a49bfe1d-2848-4a68-bb80-9ecadd44c107"
                ]
              }
            ],
            "orderRules": [
              {
