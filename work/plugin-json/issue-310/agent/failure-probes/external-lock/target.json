                "afterId": "e091d686-2744-40f6-9dad-1d68160404a2"
              }
            ]
          },
          "results": [
            {
              "id": "80d0aec8-c1a0-46b7-b515-c5eeb0236638",
              "text": "正常終了時、案内台帳に来訪日と連絡先が記録されている。"
            },
            {
              "id": "5b40fbc5-f825-4de9-aa77-bbcb0dad6d28",
              "text": "正常終了時、利用者に来訪日と連絡先が通知されている。"
            }
          ]
