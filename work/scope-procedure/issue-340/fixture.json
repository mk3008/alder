      {"id": "s-notice", "text": "顧客からの自発的な連絡を受け取る", "obligation": "optional", "appliesWhen": "連絡があったとき", "exchange": {"phase": "notification", "relationId": "r-notice", "operation": "連絡を受領"}},
      {"id": "s-one-way", "text": "顧客から確認を依頼される。応答はこの記述範囲にない", "obligation": "optional", "appliesWhen": "依頼があったとき", "exchange": {"phase": "request", "relationId": "r-external-request", "operation": "確認依頼を受領", "effect": "undecided"}}
    ], "orderRules": [{"kind": "before", "beforeId": "s-search", "afterId": "s-save"}]}, "results": [
      {"id": "result-recorded", "text": "確認結果が記録される"}, {"id": "result-pending", "text": "不明点がある場合は未決として残る"}
    ]},
    {"id": "activity-approval", "name": "承認を依頼する", "scope": true, "roleId": "role-applicant", "procedure": {"steps": [
      {"id": "s-approval", "text": "承認者へ依頼する", "obligation": "required", "appliesWhen": null, "exchange": {"phase": "request", "relationId": "r-approval", "operation": "承認依頼", "effect": "not-applicable"}},
      {"id": "s-decision", "text": "承認または拒否の結果を受け取る", "obligation": "required", "appliesWhen": null, "exchange": {"phase": "response", "relationId": "r-decision", "operation": "承認結果を受領", "replyToStepId": "s-approval"}}
    ], "orderRules": []}, "results": [{"id": "result-decision", "text": "承認結果が確認される"}]},
    {"id": "activity-external-approval", "name": "承認内容を判断する", "scope": false, "roleId": "role-approver", "procedure": {"steps": [
