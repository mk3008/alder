    ], "orderRules": []}, "results": [{"id": "result-external-decision", "text": "承認結果が決まる"}]},
    {"id": "activity-auto", "name": "記録を自動照合する", "scope": true, "roleId": null, "procedure": {"steps": [
      {"id": "s-auto", "text": "所定の条件で記録を自動照合する。担当Roleは未決", "obligation": "required", "appliesWhen": null},
      {"id": "s-object-transfer", "text": "会計システムが外部決済サービスへ送金を依頼する", "obligation": "optional", "appliesWhen": "外部送信する場合", "exchange": {"phase": "request", "operation": "送金依頼", "effect": "undecided", "unlinked": {"from": {"kind": "object", "id": "record"}, "to": {"kind": "object", "id": "external"}, "data": {"status": "ref", "dataId": "d-record"}, "reason": "現行の通常I/O RelationはObject同士を接続できない"}}}
    ], "orderRules": []}, "results": [{"id": "result-auto", "text": "照合結果が確認可能になる"}]}
